TREDINK_API_USERNAME=tredink
TREDINK_API_PASSWORD=replace-with-a-long-local-password
TREDINK_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
TREDINK_WS_TOKEN=replace-with-another-random-secret-at-least-32-characters

# Create a bot with @BotFather, start it, and enter its token and your chat ID.
TREDINK_TELEGRAM_BOT_TOKEN=
TREDINK_TELEGRAM_CHAT_ID=

# Demo risk model. Position size is capped at 50 USDT by default; it is not an order.
TREDINK_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT
TREDINK_EQUITY_USDT=1000
TREDINK_RISK_PER_TRADE=0.005
TREDINK_MAX_POSITION_PCT=0.10
TREDINK_MAX_POSITION_USDT=50
TREDINK_MIN_EXPECTED_MOVE_PCT=0.5
TREDINK_POLL_SECONDS=900
